rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /diagnostics/{report} {
      function validReport() {
        let d = request.resource.data;
        return d.keys().hasAll(['schema', 'id', 'uid', 'version', 'created_utc', 'exit_code', 'log', 'received_at'])
          && d.keys().hasOnly(['schema', 'id', 'uid', 'version', 'created_utc', 'exit_code', 'log', 'received_at'])
          && d.schema is int && d.schema == 1
          && d.uid == request.auth.uid
          && d.id is string && d.id.matches('[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}')
          && report == request.auth.uid + '_' + d.id
          && d.version is string && d.version.size() <= 32
          && d.version.matches('[0-9]+([.][0-9]+){1,3}')
          && d.created_utc is string && d.created_utc.size() <= 40
          && d.exit_code is int
          && d.log is string && d.log.toUtf8().size() <= 32768
          && d.received_at == request.time;
      }
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && validReport();
      allow read, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
